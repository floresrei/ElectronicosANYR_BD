@model ElectronicosANYR_BD.AppMVC.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 text-center text-uppercase">¿Eliminar Cliente?</h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <p class="text-muted">Estás a punto de eliminar permanentemente el registro de este cliente. Confirma los datos:</p>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="row mb-2 border-bottom pb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">Nombre Completo</div>
                            <div class="col-7 text-dark fw-bold">@Model.Nombre @Model.Apellido</div>
                        </div>

                        <div class="row mb-2 border-bottom pb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Email)</div>
                            <div class="col-7 text-dark">@Html.DisplayFor(model => model.Email)</div>
                        </div>

                        <div class="row mb-2 border-bottom pb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Telefono)</div>
                            <div class="col-7 text-dark">@Html.DisplayFor(model => model.Telefono)</div>
                        </div>

                        <div class="row mb-2 border-bottom pb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Direccion)</div>
                            <div class="col-7 text-dark small">@Html.DisplayFor(model => model.Direccion)</div>
                        </div>

                        <div class="row mb-0">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.FechaRegistro)</div>
                            <div class="col-7 text-dark small">@Html.DisplayFor(model => model.FechaRegistro)</div>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25">

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ClienteId" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm border-0">
                                Confirmar y Eliminar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar y Regresar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>