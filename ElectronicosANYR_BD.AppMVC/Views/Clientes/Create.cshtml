@model ElectronicosANYR_BD.AppMVC.Models.Cliente

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 text-center text-uppercase">Registro de Nuevo Cliente</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellido" class="form-label fw-bold small text-uppercase text-muted"></label>
                                <input asp-for="Apellido" class="form-control" placeholder="Ej: Pérez" />
                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Email" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted small">@@</span>
                                <input asp-for="Email" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Telefono" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <input asp-for="Telefono" class="form-control" placeholder="Ej: 7777-7777" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Direccion" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Dirección completa de entrega"></textarea>
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted opacity-25">

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm border-0">
                                Guardar Cliente
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar y Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}