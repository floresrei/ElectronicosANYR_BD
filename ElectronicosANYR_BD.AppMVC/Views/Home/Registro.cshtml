@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELECTRONICOS | Crear Cuenta</title>
    <style>
        :root {
            --color-primario: #0f172a;
            --color-acento: #3b82f6;
            --color-borde: #cbd5e1;
            --color-blanco: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        .register-card {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            width: 100%;
            max-width: 450px;
        }

        h2 {
            text-align: center;
            color: var(--color-primario);
            margin-bottom: 10px;
        }

        p.subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 25px;
            font-size: 0.9rem;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 5px;
            font-size: 0.85rem;
            color: #475569;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--color-borde);
            border-radius: 10px;
            font-size: 1rem;
        }

        .btn-register {
            width: 100%;
            padding: 14px;
            background: #22c55e; /* Verde para diferenciarlo del login */
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            font-size: 1rem;
            margin-top: 10px;
            transition: 0.3s;
        }

            .btn-register:hover {
                background: #16a34a;
                transform: translateY(-1px);
            }

        .footer-card {
            margin-top: 20px;
            text-align: center;
            font-size: 0.9rem;
            border-top: 1px solid #f1f5f9;
            padding-top: 20px;
        }

            .footer-card a {
                color: var(--color-acento);
                text-decoration: none;
                font-weight: bold;
            }
    </style>
</head>
<body>

    <div class="register-card">
        <h2>Crear Cuenta</h2>
        <p class="subtitle">Únete a la comunidad de ELECTRONICOS</p>

        <form asp-controller="Home" asp-action="ProcesarRegistro" method="post">
            <div class="form-group">
                <label>Nombre Completo</label>
                <input type="text" name="nombre" placeholder="Tu nombre" required>
            </div>
            <div class="form-group">
                <label>Correo Electrónico</label>
                <input type="email" name="correo" placeholder="ejemplo@correo.com" required>
            </div>
            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" placeholder="Mínimo 6 caracteres" required>
            </div>

            <button type="submit" class="btn-register">Registrarme</button>
        </form>

        <div class="footer-card">
            ¿Ya tienes cuenta? <a asp-controller="Home" asp-action="Bienvenido">Inicia sesión</a>
        </div>
    </div>

</body>
</html>