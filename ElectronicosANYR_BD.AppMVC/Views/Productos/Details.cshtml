@model ElectronicosANYR_BD.AppMVC.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 text-center text-uppercase">Detalle del Producto</h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <p class="text-muted small">Ficha técnica del artículo en inventario</p>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="row mb-3 border-bottom pb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Nombre)</div>
                            <div class="col-7 text-dark fw-bold">@Html.DisplayFor(model => model.Nombre)</div>
                        </div>

                        <div class="row mb-3 border-bottom pb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Precio)</div>
                            <div class="col-7 text-primary fw-bold">$ @Html.DisplayFor(model => model.Precio)</div>
                        </div>

                        <div class="row mb-3 border-bottom pb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Categoria)</div>
                            <div class="col-7 text-dark">
                                @(Model.Categoria != null ? Model.Categoria.Nombre : "Sin asignar")
                            </div>
                        </div>

                        <div class="row mb-0">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.FechaIngreso)</div>
                            <div class="col-7 text-dark small">@Html.DisplayFor(model => model.FechaIngreso)</div>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25">

                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model?.ProductoId" class="btn btn-primary btn-lg shadow-sm border-0">
                            Editar Información
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Volver al Listado
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>