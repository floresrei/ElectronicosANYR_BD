@model ElectronicosANYR_BD.AppMVC.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 text-center text-uppercase">Nuevo Producto</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Precio" class="form-label fw-bold small text-uppercase text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="Precio" class="form-control" placeholder="0" type="number" step="1" oninput="this.value = Math.round(this.value);" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="CategoriaId" class="form-label fw-bold small text-uppercase text-muted">Categoría</label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                <option value=""></option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted opacity-25">

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm border-0">
                                Registrar Producto
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar y Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}