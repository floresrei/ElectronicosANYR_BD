@model ElectronicosANYR_BD.AppMVC.Models.Categoria

@{
    ViewData["Title"] = "Crear Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 text-center">Nueva Categoría</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold small text-uppercase"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold small text-uppercase"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder=""></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary shadow-sm">
                                Guardar Registro
                            </button>
                            <a asp-action="Index" class="btn btn-light border">
                                Cancelar y Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
