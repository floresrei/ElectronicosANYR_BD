@model IEnumerable<ElectronicosANYR_BD.AppMVC.Models.Categoria>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<style>
    :root {
        --primario: #1e3a8a;
        --acento: #f97316;
        --fondo: #f8fafc;
        --texto: #334155;
    }

    body {
        background-color: var(--fondo);
        color: var(--texto);
    }

    /* Contenedor Principal estilo Tarjeta */
    .admin-card {
        background: white;
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        margin-top: 2rem;
    }

    .header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 1rem;
    }

    h1 {
        color: var(--primario);
        font-weight: 700;
        margin: 0;
        font-size: 1.8rem;
    }

    /* Estilos del Buscador */
    .search-container {
        margin-bottom: 1.5rem;
        position: relative;
    }

    .search-input {
        width: 100%;
        padding: 12px 20px 12px 45px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 1rem;
        transition: 0.3s;
        outline: none;
    }

        .search-input:focus {
            border-color: var(--primario);
            box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.1);
        }

    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.1rem;
        filter: grayscale(1);
    }

    /* Botón Crear */
    .btn-create {
        background-color: var(--acento);
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-create:hover {
            background-color: #ea580c;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
        }

    /* Estilos de la Tabla */
    .table-container {
        overflow-x: auto;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

        .custom-table thead {
            background-color: var(--primario);
            color: white;
        }

        .custom-table th {
            padding: 15px;
            text-align: left;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .custom-table td {
            padding: 15px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .custom-table tbody tr:hover {
            background-color: #f1f5f9;
            transition: 0.2s;
        }

    .text-description {
        color: #64748b;
        font-size: 0.9rem;
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-links {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

        .action-links a {
            text-decoration: none;
            font-size: 0.85rem;
            padding: 6px 12px;
            border-radius: 6px;
            transition: 0.2s;
            font-weight: 500;
        }

    .link-edit {
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #dbeafe;
    }

    .link-details {
        color: #059669;
        background: #ecfdf5;
        border: 1px solid #d1fae5;
    }

    .link-delete {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fee2e2;
    }

    .action-links a:hover {
        transform: scale(1.05);
    }
</style>

<div class="container">
    <div class="admin-card">
        <div class="header-flex">
            <div>
                <h1>📁 CATEGORIAS</h1>
                <p class="text-muted" style="margin-bottom:0;">Organización de productos por tipo</p>
            </div>
            <a asp-action="Create" class="btn-create">
                <span>+</span> Nueva Categoría
            </a>
        </div>

        <div class="search-container">
            <span class="search-icon">🔍</span>
            <input type="text" id="inputBuscador" class="search-input" placeholder="Buscar por nombre o descripción...">
        </div>

        <div class="table-container">
            <table class="custom-table" id="tablaCategorias">
                <thead>
                    <tr>
                        <th style="width: 25%;">@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th style="width: 40%;">@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th style="width: 15%;">@Html.DisplayNameFor(model => model.FechaCreacion)</th>
                        <th style="width: 20%; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight: 700; color: var(--primario);">
                                @Html.DisplayFor(modelItem => item.Nombre)
                            </td>
                            <td>
                                <div class="text-description" title="@item.Descripcion">
                                    @Html.DisplayFor(modelItem => item.Descripcion)
                                </div>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FechaCreacion)
                            </td>
                            <td>
                                <div class="action-links">
                                    <a asp-action="Edit" asp-route-id="@item.CategoriaId" class="link-edit">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.CategoriaId" class="link-details">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoriaId" class="link-delete">Borrar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Lógica del buscador
    document.getElementById('inputBuscador').addEventListener('keyup', function() {
        const busqueda = this.value.toLowerCase();
        const filas = document.querySelectorAll('#tablaCategorias tbody tr');

        filas.forEach(fila => {
            const textoFila = fila.innerText.toLowerCase();
            fila.style.display = textoFila.includes(busqueda) ? '' : 'none';
        });
    });
</script>