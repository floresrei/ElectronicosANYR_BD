@model ElectronicosANYR_BD.AppMVC.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 text-center text-uppercase">¿Eliminar Registro?</h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <p class="text-muted">Confirme si desea eliminar la siguiente categoría de forma permanente:</p>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="row mb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Nombre)</div>
                            <div class="col-7 text-dark fw-bold">@Html.DisplayFor(model => model.Nombre)</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.Descripcion)</div>
                            <div class="col-7 text-dark">@Html.DisplayFor(model => model.Descripcion)</div>
                        </div>
                        <div class="row mb-0">
                            <div class="col-5 text-muted small fw-bold text-uppercase">@Html.DisplayNameFor(model => model.FechaCreacion)</div>
                            <div class="col-7 text-dark small">@Html.DisplayFor(model => model.FechaCreacion)</div>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25">

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="CategoriaId" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm border-0">
                                Confirmar y Eliminar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar y Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>