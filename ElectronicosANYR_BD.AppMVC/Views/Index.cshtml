@{
  } 
  <div class="container my-5">
        <div class="row align-items-center">
            <div class="col-md-6 text-center">
                <div class="producto-card p-4 border rounded-4 shadow-sm bg-white">
                    <img id="imgPrincipal"
                         src="https://images.unsplash.com/photo-1525547718511-ad74673d887a?q=80&w=1000&auto=format&fit=crop"
                         alt="Laptop Gamer Pro"
                         class="img-fluid rounded-3 img-trigger-anyr"
                         style="cursor: zoom-in;">

                    <div class="mt-3 text-muted">
                        <small><i class="bi bi-arrows-fullscreen"></i> Haz clic para ver en pantalla completa</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 ps-md-5 mt-4 mt-md-0">
                <span class="badge bg-danger mb-2">Nuevo Lanzamiento</span>
                <h1 class="fw-bold display-6">Laptop Nitro ANYR Edition</h1>
                <p class="text-muted">Procesador de última generación, 32GB RAM, 1TB SSD.</p>

                <div class="price-tag my-4">
                    <span class="h2 text-primary fw-bold">$1,299.00</span>
                    <span class="text-decoration-line-through text-muted ms-2">$1,450.00</span>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-dark btn-lg py-3 rounded-pill">
                        Añadir al Carrito
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="visorElectronicosANYR" class="anyr-overlay">
        <div class="anyr-header">
            <span class="nombre-logo">Electronicos<b class="text-primary">ANYR</b></span>
            <span class="cerrar-visor">&times;</span>
        </div>
        <div class="anyr-body">
            <img id="imgExpandida" src="" alt="Zoom Producto">
        </div>
    </div>
